; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Я — подземелье"
config/description="Мобильный карточный рогалик: выкладывай ловушки и монстров, чтобы герои не добрались до Казны."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="1.0"
config/icon="res://icon.svg"
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.086, 0.067, 0.114, 1)

[autoload]

CrashLog="*res://scripts/core/crash_log.gd"
Data="*res://scripts/core/data.gd"
Game="*res://scripts/core/game.gd"
Progress="*res://scripts/core/progress.gd"
Sfx="*res://scripts/core/sfx.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
